# Robinhood mainnet only. Pons does not currently publish a public testnet stack.
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
FACTORY_ADDRESS=0x2f04549436Aeb3693E849E6C8121CA901edF7Ce4
RELAYER_PRIVATE_KEY=
RELAYER_API_KEY=
HOST=127.0.0.1
PORT=8787

# The Pons launch fee was 0.0005 ETH at the research snapshot. The relayer also
# reads the fee live and requires the request prefund to match it exactly.
MAX_PREFUND_WEI=500000000000000
MAX_CALLDATA_BYTES=65536
MAX_DEADLINE_SECONDS=900

# Optional relayer fee. Leave amount zero during controlled testing.
RELAYER_FEE_TOKEN=0x0000000000000000000000000000000000000000
RELAYER_FEE_AMOUNT=0
RELAYER_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Controlled server-side Pons launch. BROADCAST defaults to false in code.
LAUNCH_OWNER_PRIVATE_KEY=
RELAY_ENDPOINT=http://127.0.0.1:8787/v1/relay
BROADCAST=false
TOKEN_NAME=
TOKEN_SYMBOL=
TOKEN_SALT=
TOKEN_LOGO=
TOKEN_DESCRIPTION=
TOKEN_TWITTER=
TOKEN_TELEGRAM=
TOKEN_DISCORD=
TOKEN_WEBSITE=
TOKEN_FARCASTER=
CREATOR_TAX_BPS=0
BUYBACK_ENABLED=false
LAUNCH_CONFIG_ID=0

# Project-held STRK20 mainnet account. Supply these through a production secret
# manager. Never expose them to the browser, logs, analytics, or source control.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/REPLACE_ME
STRK20_ACCOUNT_ADDRESS=
STRK20_ACCOUNT_PRIVATE_KEY=
STRK20_VIEWING_KEY=

# Pin this only after the Layerswap/Rhino transport proof identifies the exact
# Starknet USDC contract accepted by the production route.
STRK20_USDC_ADDRESS=
