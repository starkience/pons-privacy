# Robinhood mainnet only. Pons does not currently publish a public testnet stack.
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
FACTORY_ADDRESS=0x2f04549436Aeb3693E849E6C8121CA901edF7Ce4
RELAYER_PRIVATE_KEY=
RELAYER_API_KEY=
HOST=127.0.0.1
PORT=8787

# LayerSwap partner integration. The key is server-only. Swap creation remains
# off until the funded route test freezes the exact deposit-action allowlist.
LAYERSWAP_API_KEY=
LAYERSWAP_SWAP_CREATION_ENABLED=false
LAYERSWAP_OUTBOUND_SWAP_CREATION_ENABLED=false
LAYERSWAP_OPERATION_STORE_PATH=.data/layerswap-operations.json
DEPOSIT_API_HOST=127.0.0.1
DEPOSIT_API_PORT=8788

# User-signed R2 launch application API. Preview is read-only; submission has
# an independent server-side kill switch and forwards only to the internal relayer.
APP_API_HOST=127.0.0.1
APP_API_PORT=8789
APP_API_ALLOWED_ORIGIN=http://127.0.0.1:4173
LAUNCH_OPERATION_STORE_PATH=.data/launch-operations.json
LAUNCH_SUBMISSION_ENABLED=false

# The Pons launch fee was 0.0005 ETH at the research snapshot. The relayer also
# reads the fee live and requires the request prefund to match it exactly.
MAX_PREFUND_WEI=500000000000000
MAX_CALLDATA_BYTES=65536
MAX_DEADLINE_SECONDS=900

# Optional relayer fee. Leave amount zero during controlled testing.
RELAYER_FEE_TOKEN=0x0000000000000000000000000000000000000000
RELAYER_FEE_AMOUNT=0
RELAYER_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Controlled server-side Pons launch. BROADCAST defaults to false in code.
LAUNCH_OWNER_PRIVATE_KEY=
RELAY_ENDPOINT=http://127.0.0.1:8787/v1/relay
BROADCAST=false
TOKEN_NAME=
TOKEN_SYMBOL=
TOKEN_SALT=
TOKEN_LOGO=
TOKEN_DESCRIPTION=
TOKEN_TWITTER=
TOKEN_TELEGRAM=
TOKEN_DISCORD=
TOKEN_WEBSITE=
TOKEN_FARCASTER=
CREATOR_TAX_BPS=0
BUYBACK_ENABLED=false
LAUNCH_CONFIG_ID=0

# Public STRK20 network configuration. Every user's EVM signature derives their
# own Starknet account and viewing key in browser memory; there is no shared key.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/REPLACE_ME
OZ_ACCOUNT_CLASS_HASH_MAINNET=0x01d1777db36cdd06dd62cfde77b1b6ae06412af95d57a13dc40ac77b8a702381
VITE_OZ_ACCOUNT_CLASS_HASH_MAINNET=0x01d1777db36cdd06dd62cfde77b1b6ae06412af95d57a13dc40ac77b8a702381

# Server-only AVNU credential. Browsers use the same-origin paymaster proxy.
AVNU_PAYMASTER_URL=https://starknet.paymaster.avnu.fi
AVNU_PAYMASTER_API_KEY=

# Native Starknet USDC returned by the validated LayerSwap quote route.
STRK20_USDC_ADDRESS=0x033068f6539f8e6e6b131e6b2b814e6c34a5224bc66947c47dab9dfee93b35fb
